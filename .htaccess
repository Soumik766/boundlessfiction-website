# Boundless Fiction — canonical host + basic caching

RewriteEngine On

# www → non-www, single 301 hop, https preserved.
# Google was crawling www.boundlessfiction.com as a full duplicate of the
# site; one canonical host consolidates indexing signals.
RewriteCond %{HTTP_HOST} ^www\.boundlessfiction\.com$ [NC]
RewriteRule ^(.*)$ https://boundlessfiction.com/$1 [R=301,L]

# Shared-novel links from the app. Installed app intercepts these via Android
# App Links; everyone else gets read.html (open-in-app / Google Play).
RewriteRule ^read/[A-Za-z0-9_-]+/?$ read.html [L]

# Extensionless URLs: /contact serves contact.html (the app's legal text links
# to https://boundlessfiction.com/contact).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Browser caching — images are immutable uploads; css/js carry ?v= busting.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
